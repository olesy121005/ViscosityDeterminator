<Window x:Class="ViscosityDeterminator.KnowledgeBaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="База знаний"
        Width="1100"
        Height="700"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="15">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="15"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- Левая часть — список диаграмм -->

        <Grid Grid.Column="0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <TextBlock Grid.Row="0"
                       Text="Диаграммы"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"/>


            <ListBox x:Name="DiagramsListBox"
                     Grid.Row="1"
                     DisplayMemberPath="Name"
                     SelectionChanged="DiagramsListBox_SelectionChanged"/>


            <StackPanel Grid.Row="2"
                        Margin="0,15,0,0">

                <Button x:Name="EditDiagramButton"
                        Content="РЕДАКТИРОВАТЬ ДИАГРАММУ"
                        Height="38"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,8"
                        IsEnabled="False"
                        Click="EditDiagramButton_Click"/>

                <Button Content="Закрыть"
                        Width="100"
                        Height="32"
                        HorizontalAlignment="Right"
                        Click="CloseButton_Click"/>

            </StackPanel>

        </Grid>


        <!-- Правая часть — информация и изображение -->

        <Grid Grid.Column="2">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- Информация о диаграмме -->

            <Border Grid.Row="0"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    Padding="12">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Название:"
                               FontWeight="SemiBold"/>

                    <TextBlock x:Name="DiagramNameTextBlock"
                               Grid.Row="0"
                               Grid.Column="1"
                               Text="-"/>


                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="Температура:"
                               FontWeight="SemiBold"
                               Margin="0,8,0,0"/>

                    <TextBlock x:Name="DiagramTemperatureTextBlock"
                               Grid.Row="1"
                               Grid.Column="1"
                               Text="-"
                               Margin="0,8,0,0"/>


                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="Граница:"
                               FontWeight="SemiBold"
                               Margin="0,8,0,0"/>

                    <TextBlock x:Name="BoundaryStatusTextBlock"
                               Grid.Row="2"
                               Grid.Column="1"
                               Text="Не распознана"
                               Margin="0,8,0,0"/>

                </Grid>

            </Border>


            <!-- Изображение -->

            <Border Grid.Row="2"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    Background="#F5F5F5">

                <Grid>

                    <TextBlock x:Name="PreviewPlaceholder"
                               Text="Выберите диаграмму"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="Gray"
                               FontSize="16"/>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">

                        <Image x:Name="PreviewImage"
                               Stretch="Uniform"
                               MaxWidth="750"
                               MaxHeight="520"/>

                    </ScrollViewer>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Window>