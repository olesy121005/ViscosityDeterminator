<Window x:Class="ViscosityDeterminator.ViscosityResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Результат расчёта"
        Width="1000"
        Height="750"
        MinWidth="700"
        MinHeight="500"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="ResultTextBlock"
                   Grid.Row="0"
                   FontSize="18"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

        <Border Grid.Row="1"
                BorderBrush="#BDBDBD"
                BorderThickness="1"
                Background="#F5F5F5">

            <Image x:Name="ResultImage"
                   Stretch="Uniform"
                   Margin="10"/>

        </Border>

    </Grid>

</Window>