<Window x:Class="ViscosityDeterminator.DiagramGridEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактор сетки диаграммы"
        Width="1200"
        Height="800"
        MinWidth="1000"
        MinHeight="650">

    <Grid Margin="10">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- ===================================================== -->
        <!-- ДИАГРАММА -->
        <!-- ===================================================== -->

        <Border Grid.Column="0"
                BorderBrush="#BDBDBD"
                BorderThickness="1"
                Background="#EEEEEE"
                Margin="0,0,10,0">

            <Grid>

                <Image x:Name="DiagramImage"
                       Stretch="Uniform"/>

                <Canvas x:Name="DiagramCanvas"
                        Background="Transparent"
                        MouseLeftButtonDown="DiagramCanvas_MouseLeftButtonDown"/>

            </Grid>

        </Border>

        <!-- ===================================================== -->
        <!-- ПРАВАЯ ПАНЕЛЬ -->
        <!-- ===================================================== -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Редактор сетки"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <!-- Компонент -->

            <StackPanel Grid.Row="1"
                        Margin="0,0,0,10">

                <TextBlock Text="Компонент"
                           Margin="0,0,0,5"/>

                <ComboBox x:Name="ComponentComboBox"
                          SelectedIndex="0">

                    <ComboBoxItem Content="CaO"/>
                    <ComboBoxItem Content="MgO"/>
                    <ComboBoxItem Content="SiO2"/>

                </ComboBox>

            </StackPanel>

            <!-- Значение -->

            <StackPanel Grid.Row="2"
                        Margin="0,0,0,10">

                <TextBlock Text="Значение"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="ValueTextBox"
                         Height="32"/>

                <Button Content="Изменить выбранную линию"
                        Height="35"
                        Margin="0,8,0,0"
                        Click="UpdateLineButton_Click"/>

                <Button Content="Добавить линию вручную"
                        Height="35"
                        Margin="0,8,0,0"
                        Click="AddManualLineButton_Click"/>

            </StackPanel>

            <!-- Список -->

            <ListBox x:Name="LinesListBox"
                     Grid.Row="3"
                     DisplayMemberPath="DisplayText"
                     SelectionChanged="LinesListBox_SelectionChanged"/>

            <!-- Нижние кнопки -->

            <StackPanel Grid.Row="4">

                <Button Content="Удалить выбранную линию"
                        Height="40"
                        Margin="0,10,0,5"
                        Click="DeleteLineButton_Click"/>

                <Button Content="СОХРАНИТЬ СЕТКУ"
                        Height="50"
                        FontWeight="Bold"
                        Click="SaveGridButton_Click"/>

            </StackPanel>

        </Grid>

    </Grid>

</Window>