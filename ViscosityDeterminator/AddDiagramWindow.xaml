<Window x:Class="ViscosityDeterminator.AddDiagramWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление диаграммы"
        Width="1200"
        Height="850"
        MinWidth="900"
        MinHeight="650"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Название:"
                       VerticalAlignment="Center"
                       FontSize="14"/>

            <TextBox x:Name="NameTextBox"
                     Grid.Column="1"
                     Height="35"
                     FontSize="14"
                     VerticalContentAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="225"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="215"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Al₂O₃, %:"
                       VerticalAlignment="Center"
                       FontSize="14"/>

            <TextBox x:Name="Al2O3TextBox"
                     Grid.Column="1"
                     Height="35"
                     FontSize="14"
                     VerticalContentAlignment="Center"/>

            <TextBlock Grid.Column="3"
                       Text="Температура, °C:"
                       VerticalAlignment="Center"
                       FontSize="14"/>

            <TextBox x:Name="TemperatureTextBox"
                     Grid.Column="4"
                     Height="35"
                     Width="180"
                     HorizontalAlignment="Left"
                     FontSize="14"
                     VerticalContentAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="215"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                        Content="Выбрать диаграмму..."
                        Height="35"
                        Click="SelectDiagramButton_Click"/>

                <TextBlock x:Name="SelectedFileTextBlock"
                           Grid.Column="2"
                           Margin="15,0,0,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>

            <Border Grid.Row="1"
                    BorderBrush="#BDBDBD"
                    BorderThickness="1"
                    Background="#F5F5F5">

                <Grid>
                    <Image x:Name="PreviewImage"
                           Stretch="Uniform"
                           Margin="10"/>

                    <TextBlock x:Name="PreviewPlaceholder"
                               Text="Диаграмма не выбрана"
                               FontSize="18"
                               Foreground="#777777"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>

            </Border>
        </Grid>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <Button Content="Распознать сетку"
                    Width="180"
                    Height="40"
                    Margin="0,0,10,0"
                    Click="RecognizeGridButton_Click"/>

            <Button Content="Добавить"
                    Width="110"
                    Height="40"
                    Margin="0,0,10,0"
                    Click="AddButton_Click"/>

            <Button Content="Отмена"
                    Width="110"
                    Height="40"
                    Click="CancelButton_Click"/>

        </StackPanel>

    </Grid>

</Window>