<Window x:Class="ViscosityDeterminator.AddDiagramWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление диаграммы"
        Width="1000"
        Height="700"
        MinWidth="850"
        MinHeight="600">

    <Grid Margin="15">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>

        <!-- ===================================================== -->
        <!-- ПРЕДПРОСМОТР -->
        <!-- ===================================================== -->

        <Border Grid.Column="0"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                Background="#EEEEEE"
                Margin="0,0,15,0">

            <Grid>

                <Image x:Name="PreviewImage"
                       Stretch="Uniform"/>

                <TextBlock x:Name="PreviewPlaceholder"
                           Text="Выберите изображение диаграммы"
                           FontSize="20"
                           Foreground="#777777"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

            </Grid>

        </Border>

        <!-- ===================================================== -->
        <!-- ПРАВАЯ ПАНЕЛЬ -->
        <!-- ===================================================== -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Добавление диаграммы"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <Button Grid.Row="1"
                    Content="ВЫБРАТЬ ИЗОБРАЖЕНИЕ"
                    Height="40"
                    Click="SelectDiagramButton_Click"/>

            <TextBlock x:Name="SelectedFileTextBlock"
                       Grid.Row="2"
                       Text="Файл не выбран"
                       TextWrapping="Wrap"
                       Margin="0,10,0,20"/>

            <StackPanel Grid.Row="3"
                        Margin="0,0,0,10">

                <TextBlock Text="Название диаграммы"/>

                <TextBox x:Name="NameTextBox"
                         Height="32"
                         Margin="0,5,0,0"/>

            </StackPanel>

            <Grid Grid.Row="4">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="0,0,5,0">

                    <TextBlock Text="Al₂O₃ (%)"/>

                    <TextBox x:Name="Al2O3TextBox"
                             Height="32"
                             Margin="0,5,0,0"/>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="5,0,0,0">

                    <TextBlock Text="Температура (°C)"/>

                    <TextBox x:Name="TemperatureTextBox"
                             Height="32"
                             Margin="0,5,0,0"/>

                </StackPanel>

            </Grid>

            <StackPanel Grid.Row="6">

                <Button Content="РАСПОЗНАТЬ СЕТКУ"
                        Height="40"
                        Margin="0,0,0,8"
                        Click="RecognizeGridButton_Click"/>

                <Button Content="ДОБАВИТЬ ДИАГРАММУ"
                        Height="45"
                        FontWeight="Bold"
                        Click="AddButton_Click"/>

            </StackPanel>

        </Grid>

    </Grid>

</Window>